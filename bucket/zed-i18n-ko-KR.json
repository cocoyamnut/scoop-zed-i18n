{
  "version": "1.25.2-i18n.1",
  "description": "Localized build of the Zed editor (ko-KR)",
  "homepage": "https://github.com/cocoyamnut/zed-i18n",
  "license": "GPL-3.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/cocoyamnut/zed-i18n/releases/download/v1.25.2-i18n.1/Zed-i18n-windows-x86_64.zip",
      "hash": "09990fc00d669819b4d6cf1b188b412bf361714a046072d3ed7c059ae424ba99"
    },
    "arm64": {
      "url": "https://github.com/cocoyamnut/zed-i18n/releases/download/v1.25.2-i18n.1/Zed-i18n-windows-aarch64.zip",
      "hash": "fdd74c0c3783c0654ed5e170dca9ce38ccb68f290f14dd14a3483664b5551c21"
    }
  },
  "bin": [
    [
      "bin\\zed.exe",
      "zed-i18n"
    ]
  ],
  "shortcuts": [
    [
      "Zed.exe",
      "Zed i18n (ko-KR)"
    ]
  ],
  "env_set": {
    "ZED_UPDATE_EXPLANATION": "Run 'scoop update zed-i18n-ko-KR' to update."
  },
  "post_install": [
    "$cfg = Join-Path $env:APPDATA 'Zed\\global_settings.json'",
    "$dir = Split-Path -Parent $cfg",
    "if (!(Test-Path $dir)) { New-Item -ItemType Directory -Path $dir | Out-Null }",
    "if ((Test-Path $cfg) -and ((Get-Item $cfg).Length -gt 0)) { $j = Get-Content $cfg -Raw | ConvertFrom-Json } else { $j = [pscustomobject]@{} }",
    "$j | Add-Member -MemberType NoteProperty -Name auto_update -Value $false -Force",
    "[System.IO.File]::WriteAllText($cfg, ($j | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding $false))"
  ],
  "checkver": {
    "url": "https://github.com/cocoyamnut/zed-i18n/releases/latest",
    "regex": "/releases/tag/v([\\d.]+-i18n\\.\\d+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/cocoyamnut/zed-i18n/releases/download/v$version/Zed-i18n-windows-x86_64.zip"
      },
      "arm64": {
        "url": "https://github.com/cocoyamnut/zed-i18n/releases/download/v$version/Zed-i18n-windows-aarch64.zip"
      }
    },
    "hash": {
      "url": "https://github.com/cocoyamnut/zed-i18n/releases/download/v$version/SHA256SUMS.txt"
    }
  },
  "notes": [
    "zed-i18n now ships a single build with every language included,",
    "and this package installs that build. To switch to the plain",
    "package, run: scoop uninstall zed-i18n-ko-KR; scoop install zed-i18n"
  ]
}
